{
  "type": "replace_metadata",
  "args": {
    "version": 3,
    "custom_types": {
      "input_objects": [
        {
          "name": "GetPaymentStatusInput",
          "fields": [
            { "name": "orderId", "type": "String!" }
          ]
        },
        {
          "name": "CreateOrderItemInput",
          "fields": [
            { "name": "productId", "type": "Int!" },
            { "name": "quantity", "type": "Int!" }
          ]
        },
        {
          "name": "CreateOrderAddressInput",
          "fields": [
            { "name": "fullName", "type": "String!" },
            { "name": "phone", "type": "String!" },
            { "name": "email", "type": "String!" },
            { "name": "addressLine1", "type": "String!" },
            { "name": "addressLine2", "type": "String" },
            { "name": "city", "type": "String!" },
            { "name": "state", "type": "String!" },
            { "name": "pincode", "type": "String!" }
          ]
        },
        {
          "name": "CreateStripePaymentIntentInput",
          "fields": [
            { "name": "orderId", "type": "String!" },
            { "name": "amount", "type": "numeric!" },
            { "name": "currency", "type": "String" }
          ]
        },
        {
          "name": "AuthLoginInput",
          "fields": [
            { "name": "firebaseIdToken", "type": "String!" }
          ]
        },
        {
          "name": "IssueHasuraTokenInput",
          "fields": [
            { "name": "backendJwt", "type": "String!" }
          ]
        }
      ],
      "objects": [
        {
          "name": "PaymentStatusOutput",
          "fields": [
            { "name": "status",   "type": "String!" },
            { "name": "amount",   "type": "numeric!" },
            { "name": "currency", "type": "String!" },
            { "name": "provider", "type": "String!" }
          ]
        },
        {
          "name": "CreateOrderOutput",
          "fields": [
            { "name": "orderId", "type": "String!" },
            { "name": "orderDate", "type": "String!" },
            { "name": "status", "type": "String!" },
            { "name": "orderStatus", "type": "String!" },
            { "name": "paymentStatus", "type": "String!" },
            { "name": "paymentMethod", "type": "String!" },
            { "name": "total", "type": "numeric!" }
          ]
        },
        {
          "name": "CreateStripePaymentIntentOutput",
          "fields": [
            { "name": "clientSecret", "type": "String!" },
            { "name": "paymentIntentId", "type": "String!" },
            { "name": "reused", "type": "Boolean!" }
          ]
        },
        {
          "name": "AuthUserOutput",
          "fields": [
            { "name": "id", "type": "Int!" },
            { "name": "uid", "type": "String!" },
            { "name": "email", "type": "String" },
            { "name": "provider", "type": "String!" },
            { "name": "isGuest", "type": "Boolean!" }
          ]
        },
        {
          "name": "AuthLoginOutput",
          "fields": [
            { "name": "token", "type": "String!" },
            { "name": "hasuraToken", "type": "String!" },
            { "name": "user", "type": "AuthUserOutput!" }
          ]
        },
        {
          "name": "IssueHasuraTokenOutput",
          "fields": [
            { "name": "token", "type": "String!" }
          ]
        },
        {
          "name": "InvokeEmailLambdaOutput",
          "fields": [
            { "name": "success", "type": "Boolean!" },
            { "name": "message", "type": "String!" }
          ]
        }
      ]
    },
    "actions": [
      {
        "name": "authLogin",
        "definition": {
          "kind": "synchronous",
          "handler": "{{ACTION_BASE_URL}}/hasura/actions/auth-login",
          "forward_client_headers": false,
          "headers": [
            {
              "name": "x-hasura-action-secret",
              "value_from_env": "HASURA_ACTION_SECRET"
            }
          ],
          "type": "mutation",
          "arguments": [
            { "name": "firebaseIdToken", "type": "String!" }
          ],
          "output_type": "AuthLoginOutput"
        },
        "permissions": [
          { "role": "anonymous" },
          { "role": "guest" },
          { "role": "user" }
        ],
        "comment": "Authenticate firebase id token through Hasura action and return backend+Hasura JWTs."
      },
      {
        "name": "issueHasuraToken",
        "definition": {
          "kind": "synchronous",
          "handler": "{{ACTION_BASE_URL}}/hasura/actions/issue-hasura-token",
          "forward_client_headers": false,
          "headers": [
            {
              "name": "x-hasura-action-secret",
              "value_from_env": "HASURA_ACTION_SECRET"
            }
          ],
          "type": "mutation",
          "arguments": [
            { "name": "backendJwt", "type": "String!" }
          ],
          "output_type": "IssueHasuraTokenOutput"
        },
        "permissions": [
          { "role": "anonymous" },
          { "role": "guest" },
          { "role": "user" }
        ],
        "comment": "Issue Hasura JWT from backend JWT through Hasura action."
      },
      {
        "name": "createOrder",
        "definition": {
          "kind": "synchronous",
          "handler": "{{ACTION_BASE_URL}}/hasura/actions/create-order",
          "forward_client_headers": false,
          "headers": [
            {
              "name": "x-hasura-action-secret",
              "value_from_env": "HASURA_ACTION_SECRET"
            }
          ],
          "type": "mutation",
          "arguments": [
            { "name": "items", "type": "[CreateOrderItemInput!]!" },
            { "name": "address", "type": "CreateOrderAddressInput!" },
            { "name": "paymentMethod", "type": "String!" },
            { "name": "total", "type": "numeric!" },
            { "name": "orderId", "type": "String" },
            { "name": "orderDate", "type": "String" }
          ],
          "output_type": "CreateOrderOutput"
        },
        "permissions": [
          { "role": "user" }
        ],
        "comment": "Create order from checkout through Hasura action instead of direct REST calls."
      },
      {
        "name": "createStripePaymentIntent",
        "definition": {
          "kind": "synchronous",
          "handler": "{{ACTION_BASE_URL}}/hasura/actions/create-stripe-payment-intent",
          "forward_client_headers": false,
          "headers": [
            {
              "name": "x-hasura-action-secret",
              "value_from_env": "HASURA_ACTION_SECRET"
            }
          ],
          "type": "mutation",
          "arguments": [
            { "name": "orderId", "type": "String!" },
            { "name": "amount", "type": "numeric!" },
            { "name": "currency", "type": "String" }
          ],
          "output_type": "CreateStripePaymentIntentOutput"
        },
        "permissions": [
          { "role": "user" }
        ],
        "comment": "Create or reuse Stripe payment intent via Hasura action."
      },
      {
        "name": "getPaymentStatus",
        "definition": {
          "kind": "synchronous",
          "handler": "{{ACTION_BASE_URL}}/hasura/actions/get-payment-status",
          "forward_client_headers": false,
          "headers": [
            {
              "name": "x-hasura-action-secret",
              "value_from_env": "HASURA_ACTION_SECRET"
            }
          ],
          "type": "mutation",
          "arguments": [
            { "name": "orderId", "type": "String!" }
          ],
          "output_type": "PaymentStatusOutput"
        },
        "permissions": [
          { "role": "user" }
        ],
        "comment": "Fetch payment status for an order. Frontend → Hasura Action → Express handler → DB."
      },
      {
        "name": "invokeEmailLambda",
        "definition": {
          "kind": "synchronous",
          "handler": "{{ACTION_BASE_URL}}/hasura/actions/invoke-email-lambda",
          "forward_client_headers": false,
          "headers": [
            {
              "name": "x-hasura-action-secret",
              "value_from_env": "HASURA_ACTION_SECRET"
            }
          ],
          "type": "mutation",
          "arguments": [
            { "name": "type", "type": "String!" },
            { "name": "orderId", "type": "String!" },
            { "name": "email", "type": "String!" },
            { "name": "payload", "type": "jsonb!" }
          ],
          "output_type": "InvokeEmailLambdaOutput"
        },
        "permissions": [
          { "role": "user" }
        ],
        "comment": "Invoke AWS Lambda from a Hasura action mutation."
      }
    ],
    "sources": [
      {
        "name": "default",
        "kind": "postgres",
        "configuration": {
          "connection_info": {
            "database_url": {
              "from_env": "HASURA_GRAPHQL_DATABASE_URL"
            }
          }
        },
        "tables": [
          {
            "table": { "schema": "public", "name": "products" },
            "select_permissions": [
              {
                "role": "user",
                "permission": {
                  "columns": [
                    "id",
                    "external_id",
                    "title",
                    "description",
                    "price",
                    "category",
                    "thumbnail",
                    "images",
                    "rating",
                    "stock",
                    "brand",
                    "created_at"
                  ],
                  "filter": {},
                  "allow_aggregations": true
                }
              },
              {
                "role": "guest",
                "permission": {
                  "columns": [
                    "id",
                    "external_id",
                    "title",
                    "description",
                    "price",
                    "category",
                    "thumbnail",
                    "images",
                    "rating",
                    "stock",
                    "brand",
                    "created_at"
                  ],
                  "filter": {},
                  "allow_aggregations": true
                }
              }
            ]
          },
          {
            "table": { "schema": "public", "name": "users" },
            "array_relationships": [
              {
                "name": "orders",
                "using": {
                  "foreign_key_constraint_on": {
                    "table": { "schema": "public", "name": "orders" },
                    "column": "user_id"
                  }
                }
              },
              {
                "name": "cart_items",
                "using": {
                  "foreign_key_constraint_on": {
                    "table": { "schema": "public", "name": "cart_items" },
                    "column": "user_id"
                  }
                }
              }
            ],
            "select_permissions": [
              {
                "role": "user",
                "permission": {
                  "columns": ["id", "firebase_uid", "email", "provider", "is_guest", "created_at"],
                  "filter": { "id": { "_eq": "X-Hasura-User-Id" } }
                }
              }
            ]
          },
          {
            "table": { "schema": "public", "name": "cart_items" },
            "object_relationships": [
              {
                "name": "user",
                "using": { "foreign_key_constraint_on": "user_id" }
              },
              {
                "name": "product",
                "using": { "foreign_key_constraint_on": "product_id" }
              }
            ],
            "select_permissions": [
              {
                "role": "user",
                "permission": {
                  "columns": [
                    "id",
                    "user_id",
                    "product_id",
                    "title",
                    "price",
                    "thumbnail",
                    "images",
                    "quantity",
                    "created_at",
                    "updated_at"
                  ],
                  "filter": { "user_id": { "_eq": "X-Hasura-User-Id" } },
                  "allow_aggregations": true
                }
              }
            ],
            "insert_permissions": [
              {
                "role": "user",
                "permission": {
                  "check": { "user_id": { "_eq": "X-Hasura-User-Id" } },
                  "set": { "user_id": "X-Hasura-User-Id" },
                  "columns": [
                    "product_id",
                    "title",
                    "price",
                    "thumbnail",
                    "images",
                    "quantity"
                  ]
                }
              }
            ],
            "update_permissions": [
              {
                "role": "user",
                "permission": {
                  "filter": { "user_id": { "_eq": "X-Hasura-User-Id" } },
                  "check": { "user_id": { "_eq": "X-Hasura-User-Id" } },
                  "columns": ["title", "price", "thumbnail", "images", "quantity", "updated_at"]
                }
              }
            ],
            "delete_permissions": [
              {
                "role": "user",
                "permission": {
                  "filter": { "user_id": { "_eq": "X-Hasura-User-Id" } }
                }
              }
            ]
          },
          {
            "table": { "schema": "public", "name": "orders" },
            "object_relationships": [
              {
                "name": "user",
                "using": { "foreign_key_constraint_on": "user_id" }
              }
            ],
            "array_relationships": [
              {
                "name": "order_items",
                "using": {
                  "foreign_key_constraint_on": {
                    "table": { "schema": "public", "name": "order_items" },
                    "column": "order_id"
                  }
                }
              },
              {
                "name": "shipping_addresses",
                "using": {
                  "foreign_key_constraint_on": {
                    "table": { "schema": "public", "name": "shipping_addresses" },
                    "column": "order_id"
                  }
                }
              }
            ],
            "event_triggers": [
              {
                "name": "order_inserted_start_workflow",
                "definition": {
                  "enable_manual": false,
                  "insert": { "columns": "*" }
                },
                "retry_conf": {
                  "interval_sec": 10,
                  "num_retries": 3,
                  "timeout_sec": 60
                },
                "webhook_from_env": "HASURA_ORDER_EVENT_WEBHOOK_URL",
                "headers": [
                  {
                    "name": "x-hasura-event-secret",
                    "value_from_env": "HASURA_EVENT_SECRET"
                  }
                ]
              }
            ],
            "select_permissions": [
              {
                "role": "user",
                "permission": {
                  "columns": [
                    "id",
                    "user_id",
                    "firebase_uid",
                    "order_id",
                    "status",
                    "payment_method",
                    "subtotal",
                    "total",
                    "created_at",
                    "updated_at"
                  ],
                  "filter": { "user_id": { "_eq": "X-Hasura-User-Id" } },
                  "allow_aggregations": true
                }
              }
            ]
          },
          {
            "table": { "schema": "public", "name": "order_items" },
            "object_relationships": [
              {
                "name": "order",
                "using": { "foreign_key_constraint_on": "order_id" }
              },
              {
                "name": "product",
                "using": { "foreign_key_constraint_on": "product_id" }
              }
            ],
            "select_permissions": [
              {
                "role": "user",
                "permission": {
                  "columns": [
                    "id",
                    "order_id",
                    "product_id",
                    "title",
                    "price",
                    "thumbnail",
                    "quantity",
                    "created_at"
                  ],
                  "filter": { "order": { "user_id": { "_eq": "X-Hasura-User-Id" } } },
                  "allow_aggregations": true
                }
              }
            ]
          },
          {
            "table": { "schema": "public", "name": "shipping_addresses" },
            "object_relationships": [
              {
                "name": "order",
                "using": { "foreign_key_constraint_on": "order_id" }
              }
            ],
            "select_permissions": [
              {
                "role": "user",
                "permission": {
                  "columns": [
                    "id",
                    "order_id",
                    "full_name",
                    "phone",
                    "email",
                    "address_line1",
                    "address_line2",
                    "city",
                    "state",
                    "pincode",
                    "created_at"
                  ],
                  "filter": { "order": { "user_id": { "_eq": "X-Hasura-User-Id" } } },
                  "allow_aggregations": true
                }
              }
            ]
          },
          {
            "table": { "schema": "public", "name": "payments" },
            "object_relationships": [
              {
                "name": "user",
                "using": { "foreign_key_constraint_on": "user_id" }
              },
              {
                "name": "order",
                "using": { "foreign_key_constraint_on": "order_id" }
              }
            ],
            "select_permissions": [
              {
                "role": "user",
                "permission": {
                  "columns": [
                    "id",
                    "order_id",
                    "user_id",
                    "provider",
                    "amount",
                    "currency",
                    "status",
                    "stripe_payment_intent_id",
                    "stripe_payment_method",
                    "created_at",
                    "updated_at"
                  ],
                  "filter": { "user_id": { "_eq": "X-Hasura-User-Id" } },
                  "allow_aggregations": true
                }
              }
            ]
          },
          {
            "table": { "schema": "public", "name": "inventory_reservations" },
            "object_relationships": [
              {
                "name": "user",
                "using": { "foreign_key_constraint_on": "user_id" }
              },
              {
                "name": "product",
                "using": { "foreign_key_constraint_on": "product_id" }
              }
            ],
            "select_permissions": [
              {
                "role": "user",
                "permission": {
                  "columns": [
                    "id",
                    "user_id",
                    "product_id",
                    "quantity",
                    "status",
                    "expires_at",
                    "created_at"
                  ],
                  "filter": { "user_id": { "_eq": "X-Hasura-User-Id" } },
                  "allow_aggregations": true
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
