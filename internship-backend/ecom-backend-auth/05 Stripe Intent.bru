meta {
  name: 05 Stripe Intent
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/payments/stripe/intent
  body: json
  auth: none
}

headers {
  content-type: application/json
  authorization: Bearer {{jwt}}
}

body:json {
  {
    "orderId": "{{orderId}}",
    "amount": 999,
    "currency": "inr"
  }
}
