meta {
  name: 06 Stripe Confirm
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/payments/stripe/confirm
  body: json
  auth: none
}

headers {
  content-type: application/json
  authorization: Bearer {{jwt}}
}

body:json {
  {
    "orderId": "{{orderId}}",
    "paymentIntentId": "{{paymentIntentId}}"
  }
}
